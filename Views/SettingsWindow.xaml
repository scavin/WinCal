<Window x:Class="WinCal.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_SettingsTitle}"
        Width="420" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource HoverBrush}">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource Loc_SettingsHeader}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1" x:Name="CloseButton"
                        Width="32" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="OnCloseClick">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Stretch="Uniform" Width="14" Height="14" />
                </Button>
            </Grid>
        </Border>

        <!-- 设置内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,16">

                <!-- #0 界面语言 -->
                <TextBlock Text="{DynamicResource Loc_Language}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <ComboBox x:Name="LanguageComboBox" Margin="0,0,0,20" Padding="8,6"
                          SelectedIndex="0" SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="{DynamicResource Loc_Lang_FollowSystem}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Lang_English}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Lang_SimplifiedChinese}" />
                </ComboBox>

                <!-- #1 颜色主题 -->
                <TextBlock Text="{DynamicResource Loc_Theme}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <ComboBox x:Name="ThemeComboBox" Margin="0,0,0,20" Padding="8,6"
                          SelectedIndex="0">
                    <ComboBoxItem Content="{DynamicResource Loc_Theme_FollowSystem}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Theme_Light}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Theme_Dark}" />
                </ComboBox>

                <!-- #2 字体大小 -->
                <TextBlock Text="{DynamicResource Loc_FontSize}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="A" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider Grid.Column="1" x:Name="FontSizeSlider"
                            Minimum="-2" Maximum="2" Value="0"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="A" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
                <TextBlock x:Name="FontSizeLabel" Text="标准"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,16" />

                <!-- #3 开机自启动 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Loc_AutoStartup}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="AutoStartupCheckBox"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- 替换系统任务栏日历 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc_InterceptCalendar}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_InterceptCalendarDesc}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,8,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="InterceptCalendarCheckBox"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- #4 日历数据源 -->
                <TextBlock Text="{DynamicResource Loc_DataSource}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <ComboBox x:Name="DataSourceComboBox" Margin="0,0,0,8" Padding="8,6"
                          SelectedIndex="0" SelectionChanged="OnDataSourceChanged">
                    <ComboBoxItem Content="{DynamicResource Loc_DataSource_System}" />
                    <ComboBoxItem Content="{DynamicResource Loc_DataSource_Ics}" />
                    <ComboBoxItem Content="{DynamicResource Loc_DataSource_Both}" />
                </ComboBox>

                <!-- 系统日历说明提示 -->
                <Border x:Name="SystemCalendarTip" Visibility="Visible" Margin="0,0,0,12" Padding="10,8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <TextBlock x:Name="SystemCalendarTipText" FontSize="11" TextWrapping="Wrap" LineHeight="16"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>

                <!-- ICS URL 订阅列表 -->
                <StackPanel x:Name="IcsPanel" Visibility="Collapsed" Margin="0,0,0,20">
                    <!-- 已添加的 URL 列表 -->
                    <ItemsControl x:Name="IcsUrlList" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource SeparatorBrush}"
                                        CornerRadius="6"
                                        Padding="8,6"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8"
                                                     Fill="{Binding Color}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayUrl}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="✕"
                                                    FontSize="11" Width="24" Height="24"
                                                    Padding="0" Margin="4,0,0,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="OnRemoveIcsUrl"
                                                    Tag="{Binding Index}" />
                                        </Grid>
                                        <TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Padding="4,3" Margin="14,4,0,0"
                                                 ToolTip="{DynamicResource Loc_IcsAliasTip}"
                                                 Tag="{Binding Index}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 添加新 URL -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="NewIcsUrlTextBox"
                                 Padding="8,6"
                                 ToolTip="{DynamicResource Loc_IcsUrlTip}" />
                        <Button Grid.Column="1" Content="{DynamicResource Loc_Add}"
                                Padding="12,6" Margin="6,0,0,0"
                                Background="{DynamicResource TodayAccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="OnAddIcsUrl" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Loc_RefreshInterval}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="IcsRefreshCombo"
                                  Margin="8,0,0,0" Padding="6,4"
                                  SelectedIndex="1" HorizontalAlignment="Left">
                            <ComboBoxItem Content="{DynamicResource Loc_Min10}" />
                            <ComboBoxItem Content="{DynamicResource Loc_Min30}" />
                            <ComboBoxItem Content="{DynamicResource Loc_Min60}" />
                            <ComboBoxItem Content="{DynamicResource Loc_Min120}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <!-- #5 近期事件天数 -->
                <TextBlock Text="{DynamicResource Loc_UpcomingDaysRange}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <ComboBox x:Name="UpcomingDaysCombo" Margin="0,0,0,20" Padding="8,6"
                          SelectedIndex="1">
                    <ComboBoxItem Content="{DynamicResource Loc_Day1}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Day3}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Day7}" />
                </ComboBox>

                <!-- #6 周起始日 -->
                <TextBlock Text="{DynamicResource Loc_WeekStartDay}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton x:Name="WeekStartSunday" Content="{DynamicResource Loc_Sunday}" Margin="0,0,20,0"
                                 VerticalAlignment="Center" />
                    <RadioButton x:Name="WeekStartMonday" Content="{DynamicResource Loc_Monday}"
                                 VerticalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SeparatorBrush}"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="FooterLink"
                           Text="miniCal v1.3 By www.huangao.net"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           MouseDown="OnFooterLinkClick" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource Loc_RestoreDefaults}"
                            Padding="12,6" Margin="0,0,8,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource SeparatorBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OnResetDefaults" />
                    <Button Content="{DynamicResource Loc_ExitApp}"
                            Padding="12,6" Margin="0,0,8,0"
                            Background="Transparent"
                            BorderBrush="#FFC62828"
                            Foreground="#FFC62828"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OnExitApp" />
                    <Button Content="{DynamicResource Loc_Save}"
                            Padding="20,6"
                            Background="{DynamicResource TodayAccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
